// ## The shim
//
// `shim.h` says why each of these exists. They are the three shapes C reaches and sysl does not: a
// platform's field order, a union, and a struct whose declaration order depends on the operating
// system.

extern "sysl_uv_buf_set" buf_set(b: *Buf, base: *u8, len: usize)
extern "sysl_uv_buf_base" buf_base(b: *Buf) -> *u8
extern "sysl_uv_buf_len" buf_len(b: *Buf) -> usize

extern "sysl_uv_sockaddr_family" sockaddr_family(addr: *SockAddr) -> i32
extern "sysl_uv_sockaddr_port" sockaddr_port(addr: *SockAddr) -> i32

extern "sysl_uv_hints_init" hints_init(hints: *AddrInfo, family: i32, socktype: i32, protocol: i32,
                                       flags: i32)
extern "sysl_uv_ai_next" ai_next(ai: *AddrInfo) -> *AddrInfo
extern "sysl_uv_ai_family" ai_family(ai: *AddrInfo) -> i32
extern "sysl_uv_ai_socktype" ai_socktype(ai: *AddrInfo) -> i32
extern "sysl_uv_ai_protocol" ai_protocol(ai: *AddrInfo) -> i32
extern "sysl_uv_ai_addr" ai_addr(ai: *AddrInfo) -> *SockAddr
extern "sysl_uv_ai_canonname" ai_canonname(ai: *AddrInfo) -> *u8

extern "sysl_uv_stdio_set_fd" stdio_set_fd(stdio: *StdioContainer, i: i32, flags: i32, fd: i32)
extern "sysl_uv_stdio_set_stream" stdio_set_stream(stdio: *StdioContainer, i: i32, flags: i32,
                                                   stream: *Stream)

// ## The sizes
//
// **Asked for rather than written down**, and asked for in *words* rather than bytes. A handle is
// carried above in a `[N]u64`, and an array of `u64` is 8-aligned by construction where a `[N]u8`
// promises nothing — libuv's handles hold pointers and 64-bit counters, so a misaligned one is a
// fault on a target that cares and silent corruption on one that does not.
//
// `sizeof` for the target being built for is what a `c const` block measures, so cross-compiling
// changes these without anything here being edited.

c const
    LOOP_WORDS: usize = "(sizeof(uv_loop_t) + 7) / 8"

    TCP_WORDS: usize = "(sizeof(uv_tcp_t) + 7) / 8"
    PIPE_WORDS: usize = "(sizeof(uv_pipe_t) + 7) / 8"
    TTY_WORDS: usize = "(sizeof(uv_tty_t) + 7) / 8"
    TIMER_WORDS: usize = "(sizeof(uv_timer_t) + 7) / 8"
    IDLE_WORDS: usize = "(sizeof(uv_idle_t) + 7) / 8"
