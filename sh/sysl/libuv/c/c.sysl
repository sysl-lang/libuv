// libuv, declared verbatim.
//
// **The declarations over the library the machine has.** Nothing here is meant to be called by a
// program: every name and every convention is C's, so a handle is storage the caller supplies, a
// failure is a negative integer, and a callback is one word of code with a `void *` beside it. The
// module above this one turns those into sysl and is what an application imports.
//
// **What decides which module a thing goes in is whether an APPLICATION has to name it, not whether
// it is a C artifact.** libuv's numbers are `c const` blocks in `constants.sysl` in the module
// above for exactly that reason — a program spells `RUN_DEFAULT` and `O_RDONLY`, and asking it to
// import a module documented as "nothing here is meant to be called by a program" to reach them
// would be the split leaking rather than doing its job. What stayed here are the sizes: the
// `[N]u64` a handle is carried in is this layer's business and no consumer ever writes one.
//
// The split keeps two jobs apart. This one has to be **faithful** — a signature that disagrees with
// the header links perfectly and corrupts the call at run time, and nothing in this arrangement
// checks one against the other, so each declaration below was read out of `uv.h` rather than
// remembered. The other one has to be **pleasant**, which is a different question and would
// otherwise be answered in the same breath.
//
// **The shim is three shapes and nothing else** — a struct whose field order is the platform's
// rather than libuv's, a struct libuv declares with a union in it, and `uv_buf_t`, which is
// declared one way round on Unix and the other on Windows. `shim.h` says why each one is there.

module sh.sysl.libuv.c
@link("uv")

@include("uv.h")
@include("shim.h")

// ## The handles and the requests
//
// Every one of these is a struct libuv publishes the *size* of and not the layout: the caller finds
// the storage and libuv writes its own fields into it. `opaque struct` is that claim, and it is what
// stops `timer_start` accepting a socket. The sizes are the `c const` block at the end of this file.
//
// **A handle is not relocatable.** Once initialised it is on the loop's queues, which are linked
// lists through the handle itself, so the storage has to stay where it was — which is why the layer
// above carries each one inside a `&T` and never inside a value that can be copied.

opaque struct Loop

opaque struct Handle
opaque struct Stream
opaque struct Tcp
opaque struct Pipe
opaque struct Tty
opaque struct Timer
opaque struct Idle
opaque struct Prepare
opaque struct Check
opaque struct Async
opaque struct Signal
opaque struct Process

opaque struct Req
opaque struct Write
opaque struct Connect
opaque struct Shutdown
opaque struct Fs
opaque struct GetAddrInfo

// `uv_buf_t`, whose two fields swap places between Unix and Windows. It is reached through the shim
// rather than declared, and this is the type of the storage that holds one.
opaque struct Buf

// The platform's, not libuv's: `struct sockaddr` and `struct addrinfo`.
opaque struct SockAddr
opaque struct AddrInfo

// `uv_stdio_container_t` — a flag word and a union of a stream and a descriptor.
opaque struct StdioContainer

// `uv_dir_t`, for the `opendir`/`readdir` family. Declared so that `fs_get_ptr` has something to be
// read as; nothing in the layer above uses it yet.
opaque struct Dir

// ## The structs libuv defines itself
//
// These three are libuv's own layout on every platform — it normalises what the operating system
// reported into a shape of its own — so they are declared here rather than reached through the shim.
// `tests.sysl` checks each one's size against C's.

// `uv_timespec_t`. The widths are C's `long`, which is 64 bits on the platforms this package builds
// for and 32 on a 32-bit one — `long` is sysl's name for the same thing, so the two move together.
struct Timespec
    tv_sec: long
    tv_nsec: long

// `uv_timespec64_t`, which is what `uv_clock_gettime` answers. The seconds are 64 bits whatever the
// platform, which is the whole reason it exists beside the one above.
struct Timespec64
    tv_sec: i64
    tv_nsec: i32

// `uv_timeval64_t`, which is what `uv_gettimeofday` answers.
struct Timeval64
    tv_sec: i64
    tv_usec: i32

// `uv_stat_t` — twelve unsigned 64-bit fields and four timestamps, whatever the operating system's
// own `struct stat` looks like.
struct Stat
    st_dev: u64
    st_mode: u64
    st_nlink: u64
    st_uid: u64
    st_gid: u64
    st_rdev: u64
    st_ino: u64
    st_size: u64
    st_blksize: u64
    st_blocks: u64
    st_flags: u64
    st_gen: u64
    st_atim: Timespec
    st_mtim: Timespec
    st_ctim: Timespec
    st_birthtim: Timespec
end Stat

// `uv_dirent_t`, which `fs_scandir_next` fills in one entry at a time.
struct Dirent
    name: *u8
    kind: i32

// `uv_process_options_t`. The `stdio` array is built by the shim, since each element carries a
// union; everything else here is a pointer or a number.
struct ProcessOptions
    exit_cb: *extern(*Process, i64, i32) -> unit
    file: *u8
    args: **u8
    env: **u8
    cwd: *u8
    flags: u32
    stdio_count: i32
    stdio: *StdioContainer
    uid: u32
    gid: u32
end ProcessOptions

