// The one handle another thread may touch.
//
// A loop belongs to the thread that runs it, and calling anything else in this package from a
// second thread is undefined. `send` is the exception: it is safe from anywhere, and it is how a
// worker thread gets the loop's attention.
//
//     val a = notifier(() -> drain_the_results())?
//     val wake = a.waker()
//
//     // ... on another thread, whenever there is something to drain:
//     wake.send()
//
// **What crosses is the waker rather than the handle.** A handle is a `&T` and a thread's body may
// not capture one; a waker is an address, which copies into a body the way an integer does. The
// handle has to outlive it, and a thread that owns both has that by construction.
//
// **Sends coalesce.** libuv promises the callback runs at least once after a `send`, not once per
// `send` -- several sends before the loop next turns produce one call. So the callback's job is to
// go and look at whatever the other thread left behind, rather than to be counted.
//
// **What the callback reads has to be shared safely**, and this package cannot help with that: a
// closure captures by value, so what a worker writes and the callback reads has to be behind a
// reference both of them hold, guarded by whatever the program uses to guard it.

module sh.sysl.libuv

import sh.sysl.libuv.c

/** A handle whose only operation is "wake the loop up and run this". */
struct Async
    private storage: [c.ASYNC_WORDS]u64
    private lp: &Loop
    private me: Option[&Async]
    private on_wake: &Fn() -> unit
    private on_closed: &Fn() -> unit

    private raw(*self) -> *c.Async = ptr_cast(&self.storage[0])

    /** The loop this handle is on. */
    on_loop(*self) -> &Loop = self.lp

    /** Wake the loop and have it run the callback. **Safe from any thread**, which is the whole
     * reason this handle exists.
     */
    send(*self) -> Result[unit, Error] = checked(c.async_send(self.raw()))

    /** A `send` on its own, as a value another thread may be given.
     *
     * **A handle is a `&T` and a thread's body may not capture one** -- that is the rule every
     * callback in this package is written under, and it is the compiler's rather than this
     * package's. A waker is an address and nothing else, so it copies into a body the way an
     * integer does, and `uv_async_send` is the one libuv call that is safe from any thread at all.
     *
     * **The handle has to outlive the waker.** Nothing counts here: a waker used after the handle
     * it came from was closed is the use-after-free it would be in C. The ordinary arrangement --
     * the thread owns the loop and the handle, and closes both before it returns -- has the handle
     * outliving every waker by construction.
     */
    waker(*self) -> Waker = Waker(usize(self.raw()))
end Async

/** An address a `send` may be made from. See `Async.waker`, which is the only thing that makes one.
 */
struct Waker
    private p: usize

    /** Wake the loop and have its callback run. **Safe from any thread**, and the whole point. */
    send(self) -> Result[unit, Error] = checked(c.async_send(ptr_cast(self.p)))
end Waker

impl Handle for Async
    handle_ptr(*self) -> *c.Handle = ptr_cast(&self.storage[0])

    set_close_callback(*self, cb: &Fn() -> unit) = self.on_closed = cb

    finish_close(*self)
        val cb = self.on_closed

        self.on_wake = noop
        self.on_closed = noop
        self.me = None

        cb()

private async_wake(h: *c.Async) -> unit
    val a: *Async = ptr_cast(c.handle_get_data(ptr_cast(h)))

    a.on_wake()

/** A handle that runs `cb` on the loop's thread whenever `send` is called from anywhere.
 *
 * **It is active from the moment it is created**, so it keeps the loop alive until it is closed --
 * which is what a program wants from the thing its workers are going to call, and is why `unref`
 * is worth knowing about for one that should not hold the process open on its own.
 *
 * libuv calls this a `uv_async_t`; the name here says what it does, since `async` in a language
 * with no coroutines would promise something this is not.
 */
notifier(cb: &Fn() -> unit, lp: &Loop = default_loop()) -> Result[&Async, Error]
    var a: &Async = Async([0; c.ASYNC_WORDS], lp, None, cb, noop)

    checked(c.async_init(lp.raw(), a.raw(), &async_wake))?

    a.me = Some(a)
    c.handle_set_data(a.handle_ptr(), ptr_cast(&*a))
    Ok(a)
