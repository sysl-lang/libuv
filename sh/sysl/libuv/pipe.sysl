// Named pipes and Unix domain sockets, which libuv calls one thing because they are one thing to it.
//
//     val server = pipe()?
//
//     server.bind("/tmp/my.sock")?
//     server.listen(128, () -> ...)
//
// **A pipe is a stream**, so reading, writing, shutting down and back-pressure are all in `Stream`
// and written the same way they are for TCP.
//
// **libuv removes the socket file when the handle is closed**, which is checked in this package's
// own suite rather than taken from the documentation. What it does not clean up is a socket left
// behind by a process that was killed, so a server that is restarted still wants an `unlink_sync`
// of its path before it binds -- ignoring the `ENOENT` for the ordinary case where there is none.
//
// The other use is talking to a child process, which is what `ipc` is for: a pipe created with it
// can carry a handle as well as bytes, which is how a parent hands a listening socket to a worker.
//
// ## Passing a handle
//
// **An ipc pipe carries handles as well as bytes**, and that is the portable way to spread
// connections over several processes: `TCP_REUSEPORT` is refused on macOS, so a supervisor accepts
// every connection itself and hands each accepted socket to a worker over the pipe it spawned that
// worker with. It is what Node's cluster module does by default, and it is the same mechanism --
// `SCM_RIGHTS` over a Unix domain socket -- with libuv doing the `sendmsg`.
//
// The sending side is one call:
//
//     val conn = server.accept()?               // the supervisor's accepted socket
//
//     to_worker.write_handle([1u8], conn)?      // and the worker now has a copy of it
//     conn.close()                              // this side is finished with its own
//
// **Something has to be written with it**: a handle travels attached to bytes, so the payload is
// never empty, and a single byte is the usual one. What is in it is the supervisor's business --
// which worker, which protocol, which request -- and libuv does not look at it.
//
// The receiving side takes the handle **from inside the read callback**, which is the only place a
// pending one is there to take:
//
//     from_supervisor.read_start((r) ->
//         if from_supervisor.pending_count() > 0 && from_supervisor.pending_type() == HANDLE_TCP
//             val conn = tcp()?
//
//             from_supervisor.accept_pending(conn)?
//             serve(conn))
//
// **The type has to be asked for before the handle is taken**, because `accept_pending` needs a
// handle of the right kind to put it in and only `pending_type` says which that is -- `HANDLE_TCP`
// for a socket, `HANDLE_NAMED_PIPE` for a pipe or a Unix domain socket.
//
// **Both ends must be ipc pipes**, made with `pipe(true)`. `write_handle` on one that is not is
// refused with `EINVAL`, which is libuv's own answer rather than a check added here.

module sh.sysl.libuv

import sh.sysl.libuv.c
import sysl.slices.as_mut_ptr
import sysl.text.cstring
import sysl.text.from_cstring

/** One end of a pipe: a listener, a connection, or neither yet. */
struct Pipe
    private storage: [c.PIPE_WORDS]u64
    private lp: &Loop
    private me: Option[&Pipe]
    private st: StreamState
    private on_closed: &Fn() -> unit

    private raw(*self) -> *c.Pipe = ptr_cast(&self.storage[0])

    /** The loop this pipe is on. */
    on_loop(*self) -> &Loop = self.lp

    /** Take a name: a path for a Unix domain socket, or an abstract name on Linux where the first
     * byte is a NUL. `EADDRINUSE` where the path already exists, which is the usual failure after a
     * process was killed.
     */
    bind(*self, name: string) -> Result[unit, Error]
        val n = cstring(name)

        checked(c.pipe_bind2(self.raw(), n.ptr, n.len, 0))

    /** Connect to a name, and call `cb` when the attempt finished. As with TCP, `Ok` here means the
     * attempt started and the callback carries whether it worked.
     */
    connect(*self, name: string,
            cb: &Fn(Result[unit, Error]) -> unit = ignore_status) -> Result[unit, Error]
        val n = cstring(name)
        var k: &ConnectReq = ConnectReq([0; c.CONNECT_WORDS], None, cb)

        k.me = Some(k)
        c.req_set_data(ptr_cast(k.req()), ptr_cast(&*k))

        val r = c.pipe_connect2(k.req(), self.raw(), n.ptr, n.len, 0, &connect_done)

        if r < 0
            k.me = None
            return Err(Error(r))

        Ok(())

    /** Take the next connection, from inside the callback `listen` was given. */
    accept(*self) -> Result[&Pipe, Error]
        val client = pipe(false, self.lp)?
        val r = c.accept(self.stream_ptr(), client.stream_ptr())

        if r < 0
            client.close()
            return Err(Error(r))

        Ok(client)

    /** Adopt an existing descriptor -- one end of a `pipe(2)`, an inherited socket, a descriptor a
     * child was given. **libuv owns it afterwards.**
     */
    open(*self, fd: i32) -> Result[unit, Error] = checked(c.pipe_open(self.raw(), fd))

    /** Queue `bytes` to be written and hand `send` to the peer along with them, calling `cb` when
     * the write has gone -- or when it failed.
     *
     * **This pipe must be an ipc pipe**, made with `pipe(true)`, and so must the peer's end.
     * Anything else is refused with `EINVAL`, which is libuv's own answer; a pipe that has no
     * descriptor yet is refused with `EBADF`.
     *
     * **The bytes are copied and the handle is not.** What crosses is a duplicate of the
     * descriptor, so both sides have a working handle afterwards and **this side still has to
     * close its own** -- passing a handle gives it away in the sense that the peer can use it, not
     * in the sense that it stops being ours.
     *
     * **Something must be written**, since a handle travels attached to bytes; a single byte is the
     * usual payload and an empty slice is a write with nothing to attach to.
     */
    write_handle[S: Stream](*self, bytes: []const u8, send: &S,
                            cb: &Fn(Result[unit, Error]) -> unit = ignore_status) -> Result[unit, Error]
        var w: &WriteReq = WriteReq([0; c.WRITE_WORDS], [0; c.BUF_WORDS], copy_of(bytes), None, cb)

        w.me = Some(w)
        c.buf_set(w.buf(), as_mut_ptr(w.data), w.data.len)
        c.req_set_data(ptr_cast(w.req()), ptr_cast(&*w))

        val r = c.write2(w.req(), self.stream_ptr(), w.buf(), 1, send.stream_ptr(), &write_done)

        if r < 0
            w.me = None
            return Err(Error(r))

        Ok(())

    /** How many handles the peer has sent that have not been taken yet.
     *
     * **Only ever asked from inside the read callback**: a pending handle arrives with the bytes it
     * was attached to and is gone again by the next turn of the loop, so anywhere else this is
     * zero.
     */
    pending_count(*self) -> usize
        val n = c.pipe_pending_count(self.raw())

        if n < 0 then 0 else usize(n)

    /** What the next pending handle is -- `HANDLE_TCP`, `HANDLE_NAMED_PIPE`, `HANDLE_UDP`, or
     * `UNKNOWN_HANDLE` when there is none waiting.
     *
     * This is what decides which kind of handle to make before `accept_pending`, and there is no
     * other way to find out: libuv puts the handle into whatever it is given.
     */
    pending_type(*self) -> i32 = c.pipe_pending_type(self.raw())

    /** Take the handle the peer sent into `into`, which must be a fresh handle of the kind
     * `pending_type` named and on this pipe's loop.
     *
     * **Called from inside the read callback**, once per pending handle. `EAGAIN` where there is
     * none waiting, which is what a receiver that did not check `pending_count` gets.
     *
     * What `into` becomes is connected and ready: a `Tcp` here is a socket someone else accepted,
     * with a peer already on the other end of it.
     */
    accept_pending[S: Stream](*self, into: &S) -> Result[unit, Error] =
        checked(c.accept(self.stream_ptr(), into.stream_ptr()))

    /** This end's name. */
    sockname(*self) -> Result[string, Error] = self.name_through(true)

    /** The other end's name, which a Unix domain socket usually does not have. */
    peername(*self) -> Result[string, Error] = self.name_through(false)

    /** Let others read from or write to the socket file. `READABLE`, `WRITABLE`, or both together.
     *
     * **Not `READABLE_PIPE` and `WRITABLE_PIPE`**, which are a child's stdio flags and are refused
     * here -- two pairs of names for two questions, and libuv's own header is where they diverge.
     */
    chmod(*self, flags: i32) -> Result[unit, Error] = checked(c.pipe_chmod(self.raw(), flags))

    private name_through(*self, local: bool) -> Result[string, Error]
        var buf: [1024]u8 = [0; 1024]
        var size: usize = 1024
        var r: i32 = 0

        if local
            r = c.pipe_getsockname(self.raw(), &buf[0], &size)
        else
            r = c.pipe_getpeername(self.raw(), &buf[0], &size)

        if r < 0 then return Err(Error(r))

        Ok(from_cstring(&buf[0]).unwrap_or(""))
end Pipe

impl Handle for Pipe
    handle_ptr(*self) -> *c.Handle = ptr_cast(&self.storage[0])

    set_close_callback(*self, cb: &Fn() -> unit) = self.on_closed = cb

    finish_close(*self)
        val cb = self.on_closed

        self.st.on_read = ignore_read
        self.st.on_connection = noop
        self.st.buffer = [0; 0]
        self.on_closed = noop
        self.me = None

        cb()

impl Stream for Pipe
    stream_ptr(*self) -> *c.Stream = ptr_cast(&self.storage[0])

    stream_state(*self) -> *StreamState = &self.st

/** A pipe on `lp`, connected to nothing.
 *
 * `ipc` says this pipe will be used to pass handles between processes as well as bytes, which is
 * what a parent handing a listening socket to a worker needs. It costs nothing to leave off.
 */
pipe(ipc: bool = false, lp: &Loop = default_loop()) -> Result[&Pipe, Error]
    var p: &Pipe = Pipe([0; c.PIPE_WORDS], lp, None, fresh_stream_state(), noop)

    checked(c.pipe_init(lp.raw(), p.raw(), if ipc then 1 else 0))?

    p.me = Some(p)
    c.handle_set_data(p.handle_ptr(), ptr_cast(&*p))
    Ok(p)

/** A pair of connected descriptors, the way `pipe(2)` makes one: the first reads what is written to
 * the second.
 *
 * Neither is a handle yet -- `open` on a `Pipe` is what makes one into one. This is what a parent
 * uses to wire up a child's output, since the child needs a plain descriptor.
 */
pipe_pair(read_flags: i32 = 0, write_flags: i32 = 0) -> Result[(i32, i32), Error]
    var fds: [2]i32 = [0, 0]
    val r = c.pipe_pair(&fds[0], read_flags, write_flags)

    if r < 0 then Err(Error(r)) else Ok((fds[0], fds[1]))
